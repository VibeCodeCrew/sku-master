{
  "manifest_version": 3,
  "name": "SKU Master",
  "version": "5.2.0",
  "author": "VibeCodeCrew",
  "description": "SKU Master — Glassmorphism UI v5.2.0. Сбор артикулов, bulk check, мониторинг, детекция бана.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "webRequest",
    "clipboardWrite",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://www.eldorado.ru/*",
    "*://www.mvideo.ru/*",
    "*://docs.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "iconsmall.png",
      "32": "iconsmall.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png",
        "iconsmall.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.mvideo.ru/*"
      ],
      "js": [
        "network_throttle.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.eldorado.ru/*",
        "*://www.mvideo.ru/*"
      ],
      "js": [
        "content_v2.js"
      ],
      "run_at": "document_end"
    }
  ]
}
