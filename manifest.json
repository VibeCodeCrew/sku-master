{
  "manifest_version": 3,
  "name": "SKU Master",
  "version": "5.0.1",
  "author": "VibeCodeCrew",
  "description": "Сборщик артикулов с вкладок М.Видео и Эльдорадо. Пакетное открытие из Google Docs, история обработки, мониторинг цен и наличия.",
  "permissions": ["tabs", "scripting", "storage", "webRequest", "clipboardWrite", "alarms", "notifications"],
  "host_permissions": [
    "*://www.eldorado.ru/*",
    "*://www.mvideo.ru/*",
    "*://docs.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "iconsmall.png",
      "32": "iconsmall.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png", "iconsmall.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://www.mvideo.ru/*"],
      "js": ["network_throttle.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.eldorado.ru/*", "*://www.mvideo.ru/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
